# Optional TURN server so players on mobile data / strict NATs can connect.
# Copy to .env.local and fill in (e.g. Cloudflare Calls TURN or Metered.ca free tier).
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
# Optional self-hosted PeerJS signaling server (defaults to the public 0.peerjs.com broker).
VITE_PEER_HOST=
VITE_PEER_PORT=
VITE_PEER_PATH=
